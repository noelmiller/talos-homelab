# Environment shared by both Paper servers (survival and creative). Loaded via
# envFrom; per-server differences (MEMORY, MOTD, DIFFICULTY, MODE, ...) stay
# inline in server.yaml / creative.yaml. kustomize hashes this into the
# ConfigMap name, so any change here rolls both Deployments.
EULA=TRUE
TYPE=PAPER
VERSION=26.2
TZ=America/Chicago
MAX_PLAYERS=10
VIEW_DISTANCE=10
SIMULATION_DISTANCE=8
ONLINE_MODE=TRUE
ENFORCE_SECURE_PROFILE=FALSE
ENABLE_WHITELIST=TRUE
ENFORCE_WHITELIST=TRUE
WHITELIST=dogphilosopher
WHITELIST_FILE=/config/bedrock-whitelist.json
EXISTING_WHITELIST_FILE=SYNC_FILE_MERGE_LIST
ENABLE_RCON=TRUE
RCON_PASSWORD_FILE=/run/secrets/rcon/password
# Geyser + Floodgate for Bedrock cross-play. Comma-separated (itzg accepts comma or newline).
PLUGINS=https://download.geysermc.org/v2/projects/geyser/versions/2.11.3/builds/1245/downloads/spigot,https://download.geysermc.org/v2/projects/floodgate/versions/2.2.5/builds/141/downloads/spigot
MODRINTH_PROJECTS=paper:distant-horizons-support:0.14.0
