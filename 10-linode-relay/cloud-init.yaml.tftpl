#cloud-config
hostname: ${hostname}
package_update: true
package_upgrade: true
packages:
  - nftables
  - wireguard

write_files:
  - path: /etc/sysctl.d/99-game-relay.conf
    permissions: "0644"
    content: |
      net.ipv4.ip_forward=1
      net.ipv4.conf.all.src_valid_mark=1

runcmd:
  - [sysctl, --system]
  - [systemctl, enable, nftables]
