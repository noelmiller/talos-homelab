{
  "realm": "homelab",
  "displayName": "Homelab",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "rememberMe": true,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "authenticationFlows": [
    {
      "alias": "github link existing",
      "description": "First GitHub sign-in: only link to a user that already exists, after that user proves their Keycloak password. Never creates users.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "idp-detect-existing-broker-user",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "idp-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "github",
      "displayName": "GitHub",
      "providerId": "github",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "github link existing",
      "config": {
        "clientId": "$(env:GITHUB_IDP_CLIENT_ID)",
        "clientSecret": "$(env:GITHUB_IDP_CLIENT_SECRET)",
        "defaultScope": "user:email",
        "syncMode": "IMPORT"
      }
    }
  ],
  "groups": [
    {
      "name": "forgejo-admins",
      "path": "/forgejo-admins"
    },
    {
      "name": "argocd-admins",
      "path": "/argocd-admins"
    }
  ],
  "clientScopes": [
    {
      "name": "groups",
      "description": "Group membership as a `groups` claim",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "forgejo",
      "name": "Forgejo",
      "description": "Git forge at git.k8s.noelmiller.dev",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(env:FORGEJO_OAUTH_CLIENT_SECRET)",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "https://git.k8s.noelmiller.dev",
      "baseUrl": "/",
      "redirectUris": [
        "https://git.k8s.noelmiller.dev/user/oauth2/keycloak/callback"
      ],
      "webOrigins": [
        "https://git.k8s.noelmiller.dev"
      ],
      "defaultClientScopes": [
        "basic",
        "acr",
        "profile",
        "email",
        "roles",
        "web-origins",
        "groups"
      ]
    },
    {
      "clientId": "coder",
      "name": "Coder",
      "description": "Remote development environments at coder.k8s.noelmiller.dev",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(env:CODER_OIDC_CLIENT_SECRET)",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "https://coder.k8s.noelmiller.dev",
      "baseUrl": "/",
      "redirectUris": [
        "https://coder.k8s.noelmiller.dev/api/v2/users/oidc/callback"
      ],
      "webOrigins": [
        "https://coder.k8s.noelmiller.dev"
      ],
      "defaultClientScopes": [
        "basic",
        "acr",
        "profile",
        "email",
        "roles",
        "web-origins"
      ],
      "optionalClientScopes": [
        "offline_access"
      ]
    },
    {
      "clientId": "argocd",
      "name": "Argo CD",
      "description": "GitOps UI at argocd.k8s.noelmiller.dev",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(env:ARGOCD_OIDC_CLIENT_SECRET)",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "https://argocd.k8s.noelmiller.dev",
      "baseUrl": "/",
      "redirectUris": [
        "https://argocd.k8s.noelmiller.dev/auth/callback"
      ],
      "webOrigins": [
        "https://argocd.k8s.noelmiller.dev"
      ],
      "defaultClientScopes": [
        "basic",
        "acr",
        "profile",
        "email",
        "roles",
        "web-origins",
        "groups"
      ]
    },
    {
      "clientId": "outline",
      "name": "Outline",
      "description": "Wiki at outline.k8s.noelmiller.dev",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(env:OUTLINE_OIDC_CLIENT_SECRET)",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "https://outline.k8s.noelmiller.dev",
      "baseUrl": "/",
      "redirectUris": [
        "https://outline.k8s.noelmiller.dev/auth/oidc.callback"
      ],
      "webOrigins": [
        "https://outline.k8s.noelmiller.dev"
      ],
      "attributes": {
        "post.logout.redirect.uris": "https://outline.k8s.noelmiller.dev"
      },
      "defaultClientScopes": [
        "basic",
        "acr",
        "profile",
        "email",
        "roles",
        "web-origins"
      ]
    },
    {
      "clientId": "argocd-cli",
      "name": "Argo CD CLI",
      "description": "`argocd login --sso`: public client, PKCE, loopback redirect only",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8085/auth/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "basic",
        "acr",
        "profile",
        "email",
        "roles",
        "web-origins",
        "groups"
      ]
    }
  ]
}
